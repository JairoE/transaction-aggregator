{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "--factory", "app.main:create_app", "--host", "127.0.0.1", "--port", "8000"],
