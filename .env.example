# Copy to backend/.env (or export these) before running the application.
#
# environment:
#   demo       - deterministic local fixture bank; no Plaid credentials used
#   sandbox    - Plaid Sandbox; safe for repeated development and testing
#   production - Plaid Trial/Production; consumes permanent Trial Item slots
ENVIRONMENT=demo

DATABASE_URL=sqlite+aiosqlite:///./data/transactions.db

# openssl rand -base64 48
APPLICATION_SECRET=replace-with-at-least-32-random-characters

# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-urlsafe-base64-32-byte-key
TOKEN_ENCRYPTION_KEY_VERSION=1

# Same-origin base URL. Production must be a stable HTTPS host (not loopback).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Plaid dashboard credentials. Never expose these to the frontend bundle.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-or-production-secret

# Stable HTTPS webhook endpoint, e.g. https://your-tunnel.example.com/api/webhooks/plaid
# PLAID_WEBHOOK_URL=

# Comma separated Host header allowlist.
TRUSTED_HOSTS=127.0.0.1,localhost

SYNC_INTERVAL_MINUTES=60
ENABLE_BACKGROUND_WORKER=true
